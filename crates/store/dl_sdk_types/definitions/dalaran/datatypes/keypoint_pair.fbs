namespace dalaran.datatypes;

// ---

/// A connection between two [datatypes.KeypointId]s.
table KeypointPair (
  "attr.python.aliases": "Sequence[datatypes.KeypointIdLike]",
  "attr.rust.derive": "Default, Eq, PartialEq"
) {
  /// The first point of the pair.
  keypoint0: dalaran.datatypes.KeypointId (order: 100);

  /// The second point of the pair.
  keypoint1: dalaran.datatypes.KeypointId (order: 200);
}
