namespace dalaran.blueprint.datatypes;


/// Configuration for the filter-by-range feature of the dataframe view.
table FilterByRange (
  "attr.rust.derive": "PartialEq, Eq",
  "attr.dalaran.scope": "blueprint"
) {
  /// Beginning of the time range.
  start: dalaran.datatypes.TimeInt (order: 100);

  /// End of the time range (inclusive).
  end: dalaran.datatypes.TimeInt (order: 200);
}
