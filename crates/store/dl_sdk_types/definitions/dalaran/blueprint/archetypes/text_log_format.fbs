namespace dalaran.blueprint.archetypes;


/// Configuration of the text log rows.
table TextLogFormat (
  "attr.dalaran.scope": "blueprint"
) {
  // --- Optional ---

  /// Whether to use a monospace font for the log message body.
  ///
  /// Defaults to not being enabled.
  monospace_body: dalaran.blueprint.components.Enabled ("attr.dalaran.component_optional", nullable, order: 100);
}
