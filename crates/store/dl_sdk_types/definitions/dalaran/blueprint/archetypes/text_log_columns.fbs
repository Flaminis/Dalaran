namespace dalaran.blueprint.archetypes;


/// Configuration of the text log columns.
table TextLogColumns (
  "attr.dalaran.scope": "blueprint"
) {
  // --- Optional ---


  /// What timeline columns to show.
  ///
  /// Defaults to displaying only the active timeline.
  timeline_columns: [dalaran.blueprint.components.TimelineColumn] ("attr.dalaran.component_optional", nullable, order: 1000);

  /// All columns to be displayed.
  ///
  /// Defaults to showing all text log column kinds in the order of the enum.
  text_log_columns: [dalaran.blueprint.components.TextLogColumn] ("attr.dalaran.component_optional", nullable, order: 2000);
}

