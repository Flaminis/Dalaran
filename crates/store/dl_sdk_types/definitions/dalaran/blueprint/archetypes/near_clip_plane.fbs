namespace dalaran.blueprint.archetypes;

/// Controls the distance to the near clip plane in 3D scene units.
table NearClipPlane (
    "attr.dalaran.scope": "blueprint"
) {
    /// Controls the distance to the near clip plane in 3D scene units.
    ///
    /// Content closer than this distance will not be visible.
    near_clip_plane: dalaran.blueprint.components.NearClipPlane ("attr.dalaran.component_optional", order: 1000);
}
