namespace dalaran.blueprint.components;

/// Angular speed, used for rotation speed for example.
table AngularSpeed (
  "attr.dalaran.scope": "blueprint",
  "attr.python.aliases": "float",
  "attr.python.array_aliases": "npt.ArrayLike",
  "attr.rust.derive": "Default"
) {
  /// Speed value in radians per second.
  speed: dalaran.datatypes.Float64 (order: 100);
}

