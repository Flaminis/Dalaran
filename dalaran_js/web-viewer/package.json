{
  "name": "@dalaran/web-viewer",
  "version": "0.36.0-alpha.1+dev",
  "description": "Embed the Dalaran web viewer in your app",
  "license": "Apache-2.0",
  "scripts": {
    "build:wasm": "node build-wasm.mjs --mode release",
    "build:js": "tsc",
    "build": "npm run build:wasm && npm run build:js",
    "build:wasm:debug": "node build-wasm.mjs --mode debug",
    "build:debug": "npm run build:wasm:debug && npm run build:js",
    "pack": "yarn pack --filename web-viewer.tar.gz",
    "docs": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flaminis/Dalaran.git"
  },
  "author": "dalaran-io",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Flaminis/Dalaran/issues"
  },
  "homepage": "https://dalaran.dev",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./dl_viewer.js": {
      "types": "./dl_viewer.d.ts",
      "import": "./dl_viewer.js"
    },
    "./inlined.js": {
      "types": "./inlined.d.ts",
      "import": "./inlined.js"
    }
  },
  "files": [
    "index.d.ts",
    "index.d.ts.map",
    "index.js",
    "index.js.map",
    "index.ts",
    "package.json",
    "re_viewer_bg.wasm",
    "re_viewer_bg.wasm.d.ts",
    "dl_viewer.d.ts",
    "dl_viewer.js",
    "tsconfig.json"
  ],
  "devDependencies": {
    "dts-buddy": "^0.3.0",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.3.0",
    "typescript": "^7.0.2"
  }
}